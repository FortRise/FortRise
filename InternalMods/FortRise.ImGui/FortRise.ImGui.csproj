<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\Configuration.Internals.props" />

  <PropertyGroup>
    <ModDisplayName>ImGui Debug</ModDisplayName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <Target Name="CopyNativeRuntime" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <LinuxNative Include="$(TargetDir)runtimes/linux-x64/native/**/*"/>
      <WinNative Include="$(TargetDir)runtimes/win-x64/native/**/*"/>
      <OSXNative Include="$(TargetDir)runtimes/osx/native/**/*"/>
    </ItemGroup>
    <Copy SourceFiles="@(LinuxNative)" DestinationFolder="$(TargetDir)Unmanaged/linux-x64" SkipUnchangedFiles="true"/>
    <Copy SourceFiles="@(WinNative)" DestinationFolder="$(TargetDir)Unmanaged/win-x64" SkipUnchangedFiles="true"/>
    <Copy SourceFiles="@(OSXNative)" DestinationFolder="$(TargetDir)Unmanaged/osx-x64" SkipUnchangedFiles="true"/>
  </Target>

</Project>
