<Project>
  <PropertyGroup>
    <FortRiseVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../version.txt').TrimEnd())</FortRiseVersion>
  </PropertyGroup>

	<Import Project="Configuration.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <Version>$(FortRiseVersion)</Version>
    <ModLoaderPath>..\..\.bin\$(TargetFramework)\</ModLoaderPath>
    <ModPublishPath>$(ModLoaderPath)\Internals</ModPublishPath>
    <TFPublic>true</TFPublic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FortRise.Configuration" Version="1.6.2" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ModDependency>
      <Version>$(FortRiseVersion)</Version>
    </ModDependency>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ModDependency Include="FortRise" />
  </ItemGroup>

  <Target Name="GenerateMetadata" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <ModDisplayName Condition="'$(ModDisplayName)' == ''">$([System.Text.RegularExpressions.Regex]::Replace($(MSBuildProjectName.Substring($([MSBuild]::Add($(MSBuildProjectName.LastIndexOf('.')), 1)))), '(?&lt;=[a-z0-9])(?=[A-Z])', ' '))</ModDisplayName>
      <ModDependenciesJson>@(ModDependency->'        {
            "name": "%(Identity)",
            "version": "%(Version)"
        }', ',
')</ModDependenciesJson>
      <FileContent>
{
    "name": "$(MSBuildProjectName)",
    "displayName": "$(ModDisplayName)",
    "version": "$(FortRiseVersion)",
    "priority": "Highest",
    "dependencies": [
$(ModDependenciesJson)
    ],
    "dll": "$(MSBuildProjectName).dll"
}
      </FileContent>
    </PropertyGroup>

    <WriteLinesToFile File="meta.json" Lines="$(FileContent)" Overwrite="true" />
  </Target>

  <PropertyGroup>
      <PathMap>$(MSBuildProjectDirectory)=$(ModName)/</PathMap>
  </PropertyGroup>

</Project>
